<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native chrome, matched to the web layer's dusk palette so the
         status bar and the splash don't flash a different colour than
         the app they are wrapping. -->
    <color name="colorPrimary">#241A22</color>
    <color name="colorPrimaryDark">#241A22</color>
    <color name="colorAccent">#F4785C</color>
    <color name="splashBackground">#241A22</color>
    <!-- Behind the web view. Once the app targets API 36 it is laid out
         edge to edge and Capacitor insets the web view for the system
         bars, so this colour is what shows in those strips. Matching the
         web layer's own ground keeps the seam invisible. -->
    <color name="appBackground">#F4E9E8</color>
</resources>
